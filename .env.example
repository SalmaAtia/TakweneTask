# Production settings for docker-compose.prod.yml. Copy to .env (gitignored) and replace every value.
#   cp .env.example .env && chmod 600 .env

# Public hostname. Caddy gets a Let's Encrypt certificate for it, so it must resolve to this server
# and ports 80/443 must be open. No domain? Use sslip.io with the server's IP, dashes instead of dots:
# 203.0.113.10 -> 203-0-113-10.sslip.io
SITE_HOST=your-server-ip.sslip.io

# SQL Server sa password: at least 8 characters from 3 of upper/lower/digits/symbols.
# Avoid ; ' " and $ (it is embedded in a connection string). Generate one with:
#   echo "$(openssl rand -base64 24 | tr -d '/+=')"
MSSQL_SA_PASSWORD=change-me

# JWT signing key, at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=change-me

# Demo user. The password hash is an ASP.NET Core Identity hash (see README "Deployment").
DEMO_USERNAME=Admin
DEMO_PASSWORD_HASH=change-me

# Swagger UI at https://SITE_HOST/swagger. On by default on purpose so reviewers can try the API.
SWAGGER_ENABLED=true
