# Production web server. SITE_HOST comes from .env (e.g. 1-2-3-4.sslip.io); Caddy gets and renews a
# Let's Encrypt certificate for it automatically and redirects HTTP to HTTPS.
{$SITE_HOST} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# API, Swagger UI and health check: same origin as the app, so the API needs no CORS here.
	@api path /api/* /swagger /swagger/* /health
	handle @api {
		reverse_proxy api:8080
	}

	# Angular app: unknown paths fall back to index.html so client-side routes survive a reload.
	handle {
		root * /srv
		# Hashed bundles (main-ABCD1234.js) never change; everything else (index.html) is revalidated.
		@hashed path_regexp -[A-Za-z0-9_-]{8}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@notHashed not path_regexp -[A-Za-z0-9_-]{8}\.(js|css)$
		header @notHashed Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
